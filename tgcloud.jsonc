{
  // The Mini App: `npm run build` writes dist/, `npm run deploy` builds and pushes.
  "static": {
    "source": "dist",
    "spa": true,
    // Vite's content-hashed bundles and images: cache for a year.
    "immutable": ["/assets/*"]
  },
  "$schema": "./node_modules/@tgcloud/cli/schema/tgcloud.json"
}
